# LLM API Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_or_dashscope_api_key_here
BAIDU_API_KEY=your_baidu_qianfan_api_key_here
RELAY_API_KEY=your_openai_compatible_relay_key_here

# LLM Model Selection
DEFAULT_LLM_PROVIDER=openai  # openai, anthropic/claude, gemini, zhipuai/glm, deepseek, qwen, baidu, relay
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-opus-20240229
ZHIPUAI_MODEL=glm-4  # glm-4, glm-4-plus, glm-3-turbo
GEMINI_MODEL=gemini-1.5-pro
DEEPSEEK_MODEL=deepseek-chat
QWEN_MODEL=qwen-plus
BAIDU_MODEL=ernie-4.0-turbo-8k
RELAY_MODEL=gpt-4o-mini

# Optional custom provider endpoints (proxy/gateway/self-hosted)
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
ZHIPUAI_BASE_URL=
GEMINI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAIDU_BASE_URL=
RELAY_BASE_URL=

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large

# Skill Routing (optional, enterprise)
# Enable SentenceTransformers-based semantic routing in addition to keywords.
# Note: first run may download the model weights.
SKILL_ROUTER_ENABLE_EMBEDDINGS=false
SKILL_ROUTER_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SKILL_ROUTER_EMBEDDING_MIN_SIMILARITY=0.35
SKILL_ROUTER_EMBEDDING_WEIGHT=0.35
# Redis cache TTL for `/api/v1/skills/route` (seconds)
SKILL_ROUTE_CACHE_TTL=1800

# Enterprise assets (optional overrides)
CIPHER_GENIUS_REPORT_TEMPLATES_DIR=
CIPHER_GENIUS_BENCHMARKS_DIR=
CIPHER_GENIUS_INGESTED_KNOWLEDGE_DIR=

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=crypto_knowledge

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/buildtrust

# Redis Configuration (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Generation Settings
MAX_SCHEME_VARIANTS=5
DEFAULT_TIMEOUT=60
ENABLE_CACHING=true
SAME_RUN_RETRY_BUDGET_DEFAULT=1

# Security
API_KEY_ENABLED=false
API_KEY=your_secret_api_key

# BuildCipher localhost governance state
BUILDCIPHER_GOVERNANCE_DATABASE_PATH=.cache/buildcipher/governance.sqlite3
# Compatibility only: BUILDTRUST_GOVERNANCE_DATABASE_PATH is still accepted.
